# Copy to .env and fill in once a Supabase project exists.
# See supabase/README.md for the full setup guide.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Stripe publishable key only — safe to expose to the browser.
# The secret key (sk_...) is never a VITE_ var; it's a Supabase Edge
# Function secret (STRIPE_SECRET_KEY, set via `supabase secrets set`).
VITE_STRIPE_PUBLISHABLE_KEY=
