# Copy to .env and fill in once a Supabase project exists.
# See supabase/README.md for the full setup guide.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Stripe publishable key only — safe to expose to the browser.
# The secret key (sk_...) is never a VITE_ var; it's a Supabase Edge
# Function secret (STRIPE_SECRET_KEY, set via `supabase secrets set`).
VITE_STRIPE_PUBLISHABLE_KEY=

# Partner key for the "Commissions" page (src/pages/Commission.tsx), which
# reads Exú Caveira's public product feed. Issued via exucaveira.com.br's
# admin-partners.php — safe to expose to the browser (identifies this site
# as a partner, isn't a secret credential, and can be revoked/rotated
# independently on their end).
VITE_EXUCAVEIRA_PARTNER_KEY=
